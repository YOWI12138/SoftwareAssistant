<Window x:Class="SoftwareAssistant.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="智能软件安装助手" Height="740" Width="1120"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6"
        FontFamily="Microsoft YaHei UI, Segoe UI">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#2F6FED"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#E8EAEF"/>
            <Setter Property="Foreground" Value="#3A3F47"/>
        </Style>

        <Style x:Key="FlatTextBox" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#F7F8FA"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="SelectionBrush" Value="#BBD1FA"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <!-- ============ 左侧 ============ -->
        <Grid Grid.Column="0" Margin="0,0,14,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="150"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Text="智能软件安装助手" FontSize="22" FontWeight="SemiBold" Foreground="#1A1A1A"/>
                <TextBlock Text="winget / msstore · Chocolatey · Scoop · 直链下载"
                           FontSize="12" Foreground="#8A8F99" Margin="0,5,0,0"/>
            </StackPanel>

            <TextBlock Grid.Row="1" Text="要安装的软件（每行一个，输入时会有候选提示）"
                       FontSize="12" Foreground="#6B7280" Margin="2,0,0,7"/>

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="4" Background="#FFFFFF">
                <TextBox x:Name="InputTextBox" Style="{StaticResource FlatTextBox}"
                         AcceptsReturn="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         TextChanged="InputTextBox_TextChanged"
                         Text="微信&#x0a;向日葵&#x0a;Google Chrome"/>
            </Border>

            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,0">
                <Button x:Name="StartButton" Content="开始自动安装" Width="150"
                        Style="{StaticResource PrimaryButton}" Click="StartButton_Click"/>
                <Button x:Name="ClearButton" Content="清空日志" Width="110" Margin="10,0,0,0"
                        Style="{StaticResource GhostButton}" Click="ClearButton_Click"/>
            </StackPanel>

            <StackPanel Grid.Row="4" Margin="2,14,0,0">
                <TextBlock x:Name="StatusText" Text="就绪" FontSize="12" Foreground="#6B7280"/>
                <ProgressBar x:Name="Progress" Height="6" Margin="0,7,0,0"
                             Minimum="0" Maximum="100" Value="0"
                             Foreground="#2F6FED" Background="#E8EAEF" BorderThickness="0"/>
            </StackPanel>

            <Border Grid.Row="5" Style="{StaticResource Card}" Padding="4" Margin="0,14,0,0" Background="#FFFFFF">
                <TextBox x:Name="LogTextBox" Style="{StaticResource FlatTextBox}"
                         IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                         Foreground="#374151" Background="#FAFBFC"
                         VerticalScrollBarVisibility="Auto"
                         Text="准备就绪，点击开始即可下载安装..."/>
            </Border>
        </Grid>

        <!-- ============ 右侧：已安装软件 ============ -->
        <Border Grid.Column="1" Style="{StaticResource Card}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="已安装软件" FontSize="16" FontWeight="SemiBold" Foreground="#1A1A1A"/>
                        <TextBlock x:Name="InstalledCount" Text="加载中…" FontSize="11"
                                   Foreground="#8A8F99" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="RefreshButton" Content="刷新" Width="60" Height="30"
                            Style="{StaticResource GhostButton}" Click="RefreshButton_Click"/>
                </Grid>

                <TextBox x:Name="InstalledFilter" DockPanel.Dock="Top" Style="{StaticResource FlatTextBox}"
                         Margin="0,0,0,8" FontSize="12"
                         TextChanged="InstalledFilter_TextChanged"/>

                <ListBox x:Name="InstalledList" BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         PreviewMouseRightButtonDown="InstalledList_PreviewMouseRightButtonDown">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="2"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="36">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Source="{Binding Icon}" Width="20" Height="20"
                                       VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="13" Foreground="#1F2937"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                    <TextBlock Text="{Binding Version}" FontSize="10" Foreground="#9CA3AF"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ============ 自动补全弹层 ============ -->
        <Popup x:Name="SuggestionPopup" PlacementTarget="{Binding ElementName=InputTextBox}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
               PopupAnimation="Fade" IsOpen="False">
            <Border Background="#FFFFFF" CornerRadius="8" Margin="0,6,0,0" Padding="4">
                <Border.Effect>
                    <DropShadowEffect Color="#33000000" BlurRadius="16" ShadowDepth="2" Direction="270"/>
                </Border.Effect>
                <ListBox x:Name="SuggestionList" BorderThickness="0" Background="Transparent" Width="400"
                         MouseLeftButtonUp="SuggestionList_MouseLeftButtonUp"
                         PreviewKeyDown="SuggestionList_PreviewKeyDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="30">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" FontSize="13" Foreground="#1F2937"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <Border Grid.Column="1" Background="#EEF2F7" CornerRadius="4"
                                        Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Source}" FontSize="10" Foreground="#6B7280"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Popup>
    </Grid>
</Window>
