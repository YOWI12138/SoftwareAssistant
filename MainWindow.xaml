<Window x:Class="SoftwareAssistant.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="智能软件安装助手" Height="860" Width="1420"
        WindowStartupLocation="CenterScreen"
        Background="#1B1C20"
        FontFamily="Microsoft YaHei UI, Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="CardBg" Color="#24262B"/>
        <SolidColorBrush x:Key="CardBg2" Color="#1F2126"/>
        <SolidColorBrush x:Key="TextMain" Color="#E4E6EA"/>
        <SolidColorBrush x:Key="TextSub" Color="#9AA0A8"/>
        <SolidColorBrush x:Key="Accent" Color="#4C8DFF"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#2E3138"/>
            <Setter Property="Foreground" Value="#D5D8DD"/>
        </Style>

        <Style x:Key="FlatTextBox" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="{StaticResource CardBg2}"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextMain}"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="SelectionBrush" Value="#3B5C99"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="360"/>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="350"/>
        </Grid.ColumnDefinitions>

        <!-- ============ 第 1 栏：输入与安装 ============ -->
        <Grid Grid.Column="0" Margin="0,0,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="120"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,12">
                <TextBlock Text="智能软件安装助手" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource TextMain}"/>
                <TextBlock Text="本地名录 · 并行网页检索 · winget / msstore · Choco · Scoop · 直链"
                           FontSize="11" Foreground="{StaticResource TextSub}" Margin="0,4,0,0"/>
            </StackPanel>

            <TextBlock Grid.Row="1" x:Name="CatalogHint" Text="搜索软件（中文 / 英文 / 拼音首字母）"
                       FontSize="11" Foreground="{StaticResource TextSub}" Margin="2,0,0,6"/>

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="3" Margin="0,0,0,10">
                <TextBox x:Name="SearchBox" Style="{StaticResource FlatTextBox}" FontSize="13"
                         TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown"/>
            </Border>

            <TextBlock Grid.Row="3" Text="待安装列表" FontSize="11" Foreground="{StaticResource TextSub}" Margin="2,0,0,6"/>

            <Border Grid.Row="4" Style="{StaticResource Card}" Padding="3">
                <TextBox x:Name="InputTextBox" Style="{StaticResource FlatTextBox}" FontSize="13"
                         AcceptsReturn="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         TextChanged="InputTextBox_TextChanged"
                         Text="微信&#x0a;千牛&#x0a;HP LaserJet M404"/>
            </Border>

            <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,12,0,0">
                <Button x:Name="PreviewButton" Content="① 检查匹配" Width="128"
                        Style="{StaticResource PrimaryButton}" Click="PreviewButton_Click"/>
                <Button x:Name="StartButton" Content="直接安装" Width="96" Margin="8,0,0,0"
                        Style="{StaticResource GhostButton}" Click="StartButton_Click"/>
                <Button x:Name="StopButton" Content="停止" Width="72" Margin="8,0,0,0"
                        Background="#7A2E2E" Style="{StaticResource GhostButton}" Click="StopButton_Click"/>
                <Button x:Name="ClearButton" Content="清空" Width="72" Margin="8,0,0,0"
                        Style="{StaticResource GhostButton}" Click="ClearButton_Click"/>
            </StackPanel>

            <StackPanel Grid.Row="6" Margin="2,12,0,0">
                <Grid>
                    <TextBlock x:Name="StatusText" Text="就绪" FontSize="11" Foreground="{StaticResource TextSub}"/>
                    <TextBlock x:Name="EtaText" Text="" FontSize="11" Foreground="#6BA0FF"
                               HorizontalAlignment="Right"/>
                </Grid>
                <ProgressBar x:Name="Progress" Height="7" Margin="0,6,0,0"
                             Minimum="0" Maximum="100" Value="0"
                             Foreground="{StaticResource Accent}" Background="#2E3138" BorderThickness="0"/>
            </StackPanel>

            <Border Grid.Row="7" Style="{StaticResource Card}" Padding="4" Margin="0,12,0,0">
                <RichTextBox x:Name="LogBox" BorderThickness="0" Background="#17181C"
                             Foreground="#C8CDD4" FontFamily="Consolas" FontSize="12"
                             IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                             Padding="8" IsDocumentEnabled="True">
                    <FlowDocument PageWidth="2000" LineHeight="17">
                        <Paragraph Margin="0">准备就绪。可先用搜索框挑软件，再点「检查匹配」。</Paragraph>
                    </FlowDocument>
                </RichTextBox>
            </Border>
        </Grid>

        <!-- ============ 第 2 栏：网页检索结果 ============ -->
        <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,0,12,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBlock Text="网页检索" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextMain}"/>
                    <TextBlock x:Name="WebHint" Text="安装时并行检索官网 / 下载页" FontSize="10"
                               Foreground="{StaticResource TextSub}" Margin="0,3,0,0"/>
                </StackPanel>

                <ScrollViewer x:Name="WebScroll" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="WebPanel"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ============ 第 3 栏：已安装软件 ============ -->
        <Border Grid.Column="2" Style="{StaticResource Card}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="已安装软件" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextMain}"/>
                        <TextBlock x:Name="InstalledCount" Text="加载中…" FontSize="10"
                                   Foreground="{StaticResource TextSub}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="RefreshButton" Content="刷新" Width="56" Height="28"
                            Style="{StaticResource GhostButton}" Click="RefreshButton_Click"/>
                </Grid>

                <TextBox x:Name="InstalledFilter" DockPanel.Dock="Top" Style="{StaticResource FlatTextBox}"
                         Margin="0,0,0,8" FontSize="12"
                         TextChanged="InstalledFilter_TextChanged"/>

                <ListBox x:Name="InstalledList" BorderThickness="0" Background="Transparent"
                         Foreground="{StaticResource TextMain}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         PreviewMouseRightButtonDown="InstalledList_PreviewMouseRightButtonDown">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="2"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="34">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Source="{Binding Icon}" Width="18" Height="18"
                                       VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="#3DDC84" Margin="0,0,5,0"
                                                 VerticalAlignment="Center" Visibility="{Binding NewMark}"/>
                                        <TextBlock Text="{Binding Name}" FontSize="12" Foreground="#E4E6EA"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Version}" FontSize="9" Foreground="#7C828C"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 弹层 -->
        <Popup x:Name="SearchPopup" PlacementTarget="{Binding ElementName=SearchBox}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
               PopupAnimation="Fade" IsOpen="False">
            <Border Background="#2A2D33" CornerRadius="8" Margin="0,6,0,0" Padding="4"
                    BorderBrush="#3A3E46" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#66000000" BlurRadius="16" ShadowDepth="3" Direction="270"/>
                </Border.Effect>
                <ListBox x:Name="SearchList" BorderThickness="0" Background="Transparent" Width="430"
                         Foreground="#E4E6EA"
                         MouseLeftButtonUp="SearchList_MouseLeftButtonUp"
                         PreviewKeyDown="SearchList_PreviewKeyDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="32">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" FontSize="12" Foreground="#E4E6EA"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <Border Grid.Column="1" Background="#3A3E46" CornerRadius="4"
                                        Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Id}" FontSize="9" Foreground="#A9AFB8"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Popup>

        <Popup x:Name="SuggestionPopup" PlacementTarget="{Binding ElementName=InputTextBox}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
               PopupAnimation="Fade" IsOpen="False">
            <Border Background="#2A2D33" CornerRadius="8" Margin="0,6,0,0" Padding="4"
                    BorderBrush="#3A3E46" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#66000000" BlurRadius="16" ShadowDepth="3" Direction="270"/>
                </Border.Effect>
                <ListBox x:Name="SuggestionList" BorderThickness="0" Background="Transparent" Width="430"
                         Foreground="#E4E6EA"
                         MouseLeftButtonUp="SuggestionList_MouseLeftButtonUp"
                         PreviewKeyDown="SuggestionList_PreviewKeyDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="32">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" FontSize="12" Foreground="#E4E6EA"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <Border Grid.Column="1" Background="#3A3E46" CornerRadius="4"
                                        Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Id}" FontSize="9" Foreground="#A9AFB8"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Popup>
    </Grid>
</Window>
