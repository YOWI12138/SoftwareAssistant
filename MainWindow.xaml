<Window x:Class="SoftwareAssistant.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="智能软件安装助手" Height="800" Width="1160"
        WindowStartupLocation="CenterScreen"
        Background="#1B1C20"
        FontFamily="Microsoft YaHei UI, Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="CardBg" Color="#24262B"/>
        <SolidColorBrush x:Key="CardBg2" Color="#1F2126"/>
        <SolidColorBrush x:Key="TextMain" Color="#E4E6EA"/>
        <SolidColorBrush x:Key="TextSub" Color="#9AA0A8"/>
        <SolidColorBrush x:Key="Accent" Color="#4C8DFF"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBg}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="{StaticResource Accent}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#2E3138"/>
            <Setter Property="Foreground" Value="#D5D8DD"/>
        </Style>

        <Style x:Key="FlatTextBox" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="{StaticResource CardBg2}"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextMain}"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="SelectionBrush" Value="#3B5C99"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="380"/>
        </Grid.ColumnDefinitions>

        <!-- ============ 左侧 ============ -->
        <Grid Grid.Column="0" Margin="0,0,14,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="130"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Text="智能软件安装助手" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TextMain}"/>
                <TextBlock Text="本地名录 · winget / msstore · Chocolatey · Scoop · 直链 · 驱动官网"
                           FontSize="12" Foreground="{StaticResource TextSub}" Margin="0,5,0,0"/>
            </StackPanel>

            <!-- 搜索框 -->
            <TextBlock Grid.Row="1" x:Name="CatalogHint"
                       Text="搜索软件（支持中文、英文、拼音首字母），点选后加入下方列表"
                       FontSize="12" Foreground="{StaticResource TextSub}" Margin="2,0,0,7"/>

            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="4" Margin="0,0,0,14">
                <TextBox x:Name="SearchBox" Style="{StaticResource FlatTextBox}" FontSize="14"
                         TextChanged="SearchBox_TextChanged"
                         PreviewKeyDown="SearchBox_PreviewKeyDown"/>
            </Border>

            <TextBlock Grid.Row="3" Text="待安装列表（每行一个）"
                       FontSize="12" Foreground="{StaticResource TextSub}" Margin="2,0,0,7"/>

            <Border Grid.Row="4" Style="{StaticResource Card}" Padding="4">
                <TextBox x:Name="InputTextBox" Style="{StaticResource FlatTextBox}"
                         AcceptsReturn="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         TextChanged="InputTextBox_TextChanged"
                         Text="微信&#x0a;千牛&#x0a;Google Chrome"/>
            </Border>

            <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,14,0,0">
                <Button x:Name="PreviewButton" Content="① 检查匹配并确认" Width="180"
                        Style="{StaticResource PrimaryButton}" Click="PreviewButton_Click"/>
                <Button x:Name="StartButton" Content="直接安装" Width="110" Margin="10,0,0,0"
                        Style="{StaticResource GhostButton}" Click="StartButton_Click"/>
                <Button x:Name="StopButton" Content="停止" Width="80" Margin="10,0,0,0"
                        Background="#7A2E2E" Style="{StaticResource GhostButton}" Click="StopButton_Click"/>
                <Button x:Name="ClearButton" Content="清空日志" Width="100" Margin="10,0,0,0"
                        Style="{StaticResource GhostButton}" Click="ClearButton_Click"/>
            </StackPanel>

            <StackPanel Grid.Row="6" Margin="2,14,0,0">
                <TextBlock x:Name="StatusText" Text="就绪" FontSize="12" Foreground="{StaticResource TextSub}"/>
                <ProgressBar x:Name="Progress" Height="6" Margin="0,7,0,0"
                             Minimum="0" Maximum="100" Value="0"
                             Foreground="{StaticResource Accent}" Background="#2E3138" BorderThickness="0"/>
            </StackPanel>

            <Border Grid.Row="7" Style="{StaticResource Card}" Padding="4" Margin="0,14,0,0">
                <TextBox x:Name="LogTextBox" Style="{StaticResource FlatTextBox}"
                         IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                         Background="#17181C" Foreground="#C8CDD4"
                         VerticalScrollBarVisibility="Auto"
                         Text="准备就绪。可先用上方搜索框挑软件，再点「检查匹配并确认」。"/>
            </Border>
        </Grid>

        <!-- ============ 右侧：已安装软件 ============ -->
        <Border Grid.Column="1" Style="{StaticResource Card}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="已安装软件" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextMain}"/>
                        <TextBlock x:Name="InstalledCount" Text="加载中…" FontSize="11"
                                   Foreground="{StaticResource TextSub}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="RefreshButton" Content="刷新" Width="60" Height="30"
                            Style="{StaticResource GhostButton}" Click="RefreshButton_Click"/>
                </Grid>

                <TextBox x:Name="InstalledFilter" DockPanel.Dock="Top" Style="{StaticResource FlatTextBox}"
                         Margin="0,0,0,8" FontSize="12"
                         TextChanged="InstalledFilter_TextChanged"/>

                <ListBox x:Name="InstalledList" BorderThickness="0" Background="Transparent"
                         Foreground="{StaticResource TextMain}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         PreviewMouseRightButtonDown="InstalledList_PreviewMouseRightButtonDown">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="2"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="36">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Image Grid.Column="0" Source="{Binding Icon}" Width="20" Height="20"
                                       VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Fill="#3DDC84" Margin="0,0,6,0"
                                                 VerticalAlignment="Center" Visibility="{Binding NewMark}"/>
                                        <TextBlock Text="{Binding Name}" FontSize="13" Foreground="#E4E6EA"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Version}" FontSize="10" Foreground="#7C828C"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ============ 搜索框弹层 ============ -->
        <Popup x:Name="SearchPopup" PlacementTarget="{Binding ElementName=SearchBox}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
               PopupAnimation="Fade" IsOpen="False">
            <Border Background="#2A2D33" CornerRadius="8" Margin="0,6,0,0" Padding="4"
                    BorderBrush="#3A3E46" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#66000000" BlurRadius="16" ShadowDepth="3" Direction="270"/>
                </Border.Effect>
                <ListBox x:Name="SearchList" BorderThickness="0" Background="Transparent" Width="460"
                         Foreground="#E4E6EA"
                         MouseLeftButtonUp="SearchList_MouseLeftButtonUp"
                         PreviewKeyDown="SearchList_PreviewKeyDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="34">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" FontSize="13" Foreground="#E4E6EA"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <Border Grid.Column="1" Background="#3A3E46" CornerRadius="4"
                                        Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Id}" FontSize="10" Foreground="#A9AFB8"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Popup>

        <!-- ============ 待安装列表自动补全弹层 ============ -->
        <Popup x:Name="SuggestionPopup" PlacementTarget="{Binding ElementName=InputTextBox}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
               PopupAnimation="Fade" IsOpen="False">
            <Border Background="#2A2D33" CornerRadius="8" Margin="0,6,0,0" Padding="4"
                    BorderBrush="#3A3E46" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="#66000000" BlurRadius="16" ShadowDepth="3" Direction="270"/>
                </Border.Effect>
                <ListBox x:Name="SuggestionList" BorderThickness="0" Background="Transparent" Width="460"
                         Foreground="#E4E6EA"
                         MouseLeftButtonUp="SuggestionList_MouseLeftButtonUp"
                         PreviewKeyDown="SuggestionList_PreviewKeyDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="34">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" FontSize="13" Foreground="#E4E6EA"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <Border Grid.Column="1" Background="#3A3E46" CornerRadius="4"
                                        Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Id}" FontSize="10" Foreground="#A9AFB8"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Popup>
    </Grid>
</Window>
