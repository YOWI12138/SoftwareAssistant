<Window x:Class="SoftwareAssistant.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="智能软件安装助手" Height="520" Width="620"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="请每行输入一个软件（名称 / 包 ID / 安装包直链）：" FontSize="14" Margin="0,0,0,10"/>

        <TextBox x:Name="InputTextBox" Grid.Row="1" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="14"
                 Margin="0,0,0,10" Text="微信&#x0a;向日葵&#x0a;Google Chrome"/>

        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock x:Name="StatusText" Text="就绪" FontSize="12" Foreground="#666666"
                           TextTrimming="CharacterEllipsis"/>
                <ProgressBar x:Name="Progress" Height="10" Margin="0,6,0,0"
                             Minimum="0" Maximum="100" Value="0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="StartButton" Content="开始自动安装" Width="120" Height="40"
                        FontSize="14" Click="StartButton_Click" Background="#0078D7" Foreground="White"/>
                <Button x:Name="ClearButton" Content="清空日志" Width="100" Height="40"
                        FontSize="14" Margin="10,0,0,0" Click="ClearButton_Click"/>
            </StackPanel>
        </Grid>

        <TextBox x:Name="LogTextBox" Grid.Row="1" Margin="0,160,0,80"
                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" IsReadOnly="True"
                 Background="#F0F0F0" Text="准备就绪，点击开始即可下载安装..."/>
    </Grid>
</Window>
